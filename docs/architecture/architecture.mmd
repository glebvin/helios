  %% HELIOS  ·  один код, кабинет в каждой записи
  pwa["<b>Веб и PWA</b><br/>React · стол и поле<br/>Сводка помечена как учебная<br/>Кнопки поля от 48px"]:::client
  outbox["<b>Очередь телефона</b><br/>кабинет и пользователь<br/>Смена и объём ждут сеть<br/>Чужой кабинет не забирает события"]:::client
  api["<b>API NestJS</b><br/>TenantContext обязателен<br/>Заголовок только выбирает кабинет<br/>Приёмка считается в транзакции"]:::service
  rules["<b>Правила</b><br/>packages/domain<br/>Частичная приёмка 18 и 17<br/>Не больше трёх виз"]:::rule
  worker["<b>Worker</b><br/>тот же код, другой процесс<br/>Повтор не удваивает эффект<br/>Один тяжёлый ход на кабинет"]:::service
  pg["<b>PostgreSQL</b><br/>данные, RLS и pg-boss<br/>tenant_id в связях<br/>set_config только внутри транзакции"]:::store
  files["<b>Файлы</b><br/>ключ начинается с кабинета<br/>S3, когда поднят MinIO<br/>Ссылка не заменяет проверку права"]:::store
