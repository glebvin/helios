import assert from 'node:assert/strict';import{mkdir,writeFile}from'node:fs/promises';import{fileURLToPath}from'node:url';import pg from'pg';import{chromium}from'playwright';
import{assertVolumeReviewDatabase}from'../apps/api/test/volume-review-fixture.js';import{internalInspectionFixture}from'../apps/api/test/internal-inspection-fixture.js';
assert.equal(process.env.HELIOS_VOLUME_QA_DB_PORT,'54671');const out=fileURLToPath(new URL('../.data/rollback-browser/',import.meta.url));await mkdir(out,{recursive:true});const admin=new pg.Pool({connectionString:process.env.ADMIN_DATABASE_URL});await assertVolumeReviewDatabase(admin);
const f=await internalInspectionFixture(admin,'http://127.0.0.1:4473');await f.configure();for(const[a,v]of[['submit',0],['responsible',1],['approve',2]]as const)assert.equal((await f.action(0,a,v)).status,201);
await f.ok(`/projects/${f.project}/tasks/${f.parts[0].taskId}/checklist-runs`,f.command({expectedVersion:1,templateId:f.template,edition:1,answers:[{itemId:'ready',value:'yes'}]}),'master');
const path=`/projects/${f.project}/volume-reviews/${f.parts[0].reportId}`,endpoint=path+'/remainder';
const browser=await chromium.launch(),page=await browser.newPage({viewport:{width:1280,height:900}}),errors:string[]=[];page.on('pageerror',e=>errors.push(e.message));
async function quality(){await page.getByLabel('Объект',{exact:true}).selectOption(f.project);await page.getByRole('button',{name:'Приёмка',exact:true}).click();await page.getByRole('button',{name:'Самоконтроль мастера',exact:true}).click();await page.getByLabel('День предъявления',{exact:true}).fill(f.day);await page.getByRole('button',{name:'Открыть предъявление Кладка 1',exact:true}).filter({visible:true}).click();await page.getByRole('heading',{name:'Самоконтроль объёма',exact:true}).waitFor();await page.waitForTimeout(200);}
async function login(key:string,port=5351){await page.goto(`http://127.0.0.1:${port}`);await page.evaluate(()=>localStorage.removeItem('helios.session'));await page.reload();await page.getByLabel('Логин',{exact:true}).fill(f.actors[key].email);await page.getByLabel('Пароль',{exact:true}).fill(f.password);await page.getByRole('button',{name:'Войти',exact:true}).click();await quality();}
async function call(p:string,b?:unknown,key='master'){const r=await fetch('http://127.0.0.1:4471/api/v1'+p,{method:b?'POST':'GET',headers:f.headers(key),body:b?JSON.stringify(b):undefined});return{status:r.status,body:await r.json()};}
try{
 await login('master',5353);await page.getByRole('button',{name:'Предъявить остаток',exact:true}).click();await page.getByLabel('Что исправлено в остатке',{exact:true}).fill('Участок исправлен');await page.getByRole('button',{name:'Подтвердить предъявление остатка',exact:true}).click();await page.getByRole('button',{name:'Принять остаток',exact:true}).click();
 let resolve!:()=>void;const committed=new Promise<void>(r=>resolve=r),commands:any[]=[];let original:any,reply:any;
