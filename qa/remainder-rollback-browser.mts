 // Same newer UI/storage, now served by the actual rollback API instead of the full writer.
 await page.route('**/api/v1/**',async route=>{const u=new URL(route.request().url());const response=await route.fetch({url:'http://127.0.0.1:4471'+u.pathname+u.search});if(u.pathname.endsWith(endpoint)&&route.request().method()==='POST'){commands.push(route.request().postDataJSON());assert.equal(response.status(),201);reply=await response.json();}await route.fulfill({response});});
 await page.reload();await quality();await page.getByRole('button',{name:'Повторить запись остатка',exact:true}).click();await page.getByText('Остаток подтверждён сервером.',{exact:true}).waitFor();assert.deepEqual(commands[1],commands[0]);assert.deepEqual(reply,original);await page.getByText('Принято всего: 18 м2. Осталось: 0 м2.',{exact:true}).waitFor();await page.unrouteAll({behavior:'wait'});
 const next=f.command({expectedVersion:1,action:'present',quantity:'1',checklistRunId:f.parts[1].checklistRunId,reason:'Ещё исправление'});assert.equal((await call(`/projects/${f.project}/volume-reviews/${f.parts[1].reportId}/remainder`,next)).status,503);assert.equal((await admin.query('SELECT 1 FROM people_command_receipts WHERE tenant_id=$1 AND actor_user_id=$2 AND request_id=$3',[f.tenant,f.actors.master.id,next.requestId])).rowCount,0);assert.equal((await call(endpoint,{...commands[0],quantity:'0.5'})).status,409);
 await login('master');await page.getByText(/Режим возврата: новые предъявления/).waitFor();assert.equal(await page.getByRole('button',{name:'Предъявить остаток',exact:true}).count(),0);assert.equal(await page.getByRole('button',{name:'Принять остаток',exact:true}).count(),0);await page.getByText('ПТО: часть 1 м2',{exact:true}).click();await page.getByRole('button',{name:'Передать нашему ПТО',exact:true}).click();await page.getByText('Ждёт ответственного РП',{exact:true}).waitFor();
 await login('director');await page.getByText('ПТО: часть 1 м2',{exact:true}).click();await page.getByRole('button',{name:'Подтвердить ответственность',exact:true}).click();await page.getByText('Ждёт решения ПТО',{exact:true}).waitFor();await login('pto2');await page.getByText('ПТО: часть 1 м2',{exact:true}).click();assert.equal(await page.getByRole('button',{name:'Принять часть',exact:true}).count(),0);await login('pto');await page.getByText('ПТО: часть 1 м2',{exact:true}).click();await page.getByRole('button',{name:'Принять часть',exact:true}).click();await page.getByText('Приёмка подтверждена сервером.',{exact:true}).waitFor();await page.getByText('Принято нашим ПТО',{exact:true}).nth(1).waitFor();await page.reload();await quality();await page.getByText('ПТО: часть 1 м2',{exact:true}).click();await page.screenshot({path:out+'desktop.png',fullPage:true});await page.setViewportSize({width:390,height:844});assert.ok(await page.evaluate(()=>document.documentElement.scrollWidth-innerWidth)<=1);await page.screenshot({path:out+'mobile.png',fullPage:true});await page.getByRole('button',{name:'Закрыть',exact:true}).click();await page.getByRole('dialog').waitFor({state:'hidden'});
 const row=(await call(path)).body;assert.equal(row.totalAcceptedQuantity,'18.000');assert.equal(row.review.acceptedQuantity,'17.000');assert.deepEqual(row.remainder.allowedActions,[]);assert.equal((await call(`/projects/${f.project}/accepted-parts/${row.remainder.history[1].acceptedPartId}/internal-inspection`,undefined,'pto')).body.state,'accepted');assert.deepEqual(errors,[]);
 await writeFile(out+'result.json',JSON.stringify({ok:true,realFullWriterLost201ThenRollbackReplay:true,exactBodyAndReceipt:true,total:'18.000',original:'17.000',newWrites503WithoutReceipt:true,changedBody409:true,newerUiAndRollbackUi:true,newPartPtoCompletedByRollback:true,otherPtoReadOnly:true,mobile390:true,closeReachable:true,errors},null,2));console.log('Rollback UI/API: exact newer receipt,18 total, no new writes, PTO continuation,390px passed.');
}catch(e){await page.screenshot({path:out+'failure.png',fullPage:true}).catch(()=>{});await writeFile(out+'failure.txt',await page.locator('body').innerText().catch(()=>''));throw e;}finally{await browser.close();await admin.end();}
