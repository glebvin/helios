  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "64 hexadecimal characters"
      }
    },
    "parameters": {
      "TenantId": {
        "name": "x-tenant-id",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 25
        }
      },
      "Offset": {
        "name": "offset",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      },
      "Day": {
        "name": "day",
        "in": "query",
        "schema": {
          "type": "string",
          "format": "date"
        },
        "description": "Valid YYYY-MM-DD civil date. Overview defaults to today in tenant timezone; tasks omit date filtering when absent."
      },
      "ProjectId": {
        "name": "projectId",
        "in": "query",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "Ok": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": false
      },
      "Actor": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "tenantId": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": [
              "director",
              "master",
              "pto",
              "worker"
            ]
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "userId",
          "tenantId",
          "role",
          "name",
          "email"
        ],
        "additionalProperties": false
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "name"
        ],
        "additionalProperties": false
      },
      "Membership": {
        "type": "object",
        "properties": {
          "tenant_id": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "active"
            ]
          }
        },
        "required": [
          "tenant_id",
          "role",
          "status"
        ],
        "additionalProperties": false
      },
      "LoginInput": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 320,
            "minLength": 1
          },
          "password": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 1
          }
        },
        "required": [
          "email",
          "password"
        ],
        "additionalProperties": true
      },
      "Login": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "memberships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Membership"
            }
          }
        },
        "required": [
          "token",
          "user",
          "memberships"
        ],
        "additionalProperties": false
      },
      "Project": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false
      },
      "Employee": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "fullName": {
            "type": "string"
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "organizationId": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          }
        },
        "required": [
          "id",
          "fullName",
          "phone",
          "organizationId",
          "userId"
        ],
        "additionalProperties": false
      },
      "Task": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "projectId": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "workDate": {
            "type": "string",
            "format": "date"
          },
          "plannedQuantity": {
            "type": "string",
            "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
          },
          "unit": {
            "type": "string"
          },
          "assigneeEmployeeId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "id",
          "projectId",
          "title",
          "workDate",
          "plannedQuantity",
          "unit",
          "assigneeEmployeeId",
          "status",
          "version"
        ],
        "additionalProperties": false
      },
      "UnavailableMetric": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "unavailable"
            ]
          },
          "value": {
            "type": "number",
            "nullable": true,
            "enum": [
              null
            ]
          },
          "source": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "value",
          "source"
        ],
        "additionalProperties": false
      },
      "Quantity": {
        "type": "object",
        "properties": {
          "unit": {
            "type": "string"
          },
          "submittedQuantity": {
            "type": "string",
            "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
          },
          "acceptedQuantity": {
            "type": "string",
            "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$",
            "nullable": true
          }
        },
        "required": [
          "unit",
          "submittedQuantity",
          "acceptedQuantity"
        ],
        "additionalProperties": false
      },
      "Overview": {
        "type": "object",
        "properties": {
          "day": {
            "type": "string",
            "format": "date"
          },
          "timezone": {
            "type": "string"
          },
          "projectId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "assignedEmployees": {
            "type": "integer",
            "minimum": 0
          },
          "tasksForDay": {
            "type": "integer",
            "minimum": 0
          },
          "employeesStartedShiftsForDay": {
            "type": "integer",
            "minimum": 0
          },
          "currentOpenShifts": {
            "type": "integer",
            "minimum": 0
          },
          "submittedReportsForDay": {
            "type": "integer",
            "minimum": 0
          },
          "reviewedReportsForDay": {
            "type": "integer",
            "minimum": 0
          },
          "quantities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Quantity"
            }
          },
          "shiftStartSource": {
            "type": "string"
          },
          "reportDateSource": {
            "type": "string"
          },
          "quality": {
            "$ref": "#/components/schemas/UnavailableMetric"
          },
          "downtimeDuration": {
            "$ref": "#/components/schemas/UnavailableMetric"
          },
          "idReadiness": {
            "$ref": "#/components/schemas/UnavailableMetric"
          }
